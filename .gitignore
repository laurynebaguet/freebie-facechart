# Photos personnelles : elles servent seulement à caler les couleurs,
# l'application n'en a pas besoin, et le dépôt est public.
swatch*.jpg
swatch*.jpeg
images/references/

# Les dessins en haute resolution : plusieurs Mo chacun, inutiles en ligne.
# L'application ne se sert que des copies allegees, posees dans
# images/visages/ par outils/reduire-visage.ps1. Les originaux restent ici,
# sur ton disque et dans OneDrive.
images/visages/originaux/

# Réglages locaux de l'éditeur
.claude/

# Fichiers créés par Windows et OneDrive
Thumbs.db
desktop.ini
*.tmp
~$*
